<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>A case that is already Escalated and already reviewed has its priority changed: Needs Review stays unticked, because the status did not move. Twin: T03, where the status moves to Escalated and the box is ticked. Without T03 this test would also pass on a broken flow.</description>
    <flowApiName>Case_Set_Review_Flag</flowApiName>
    <label>T04 Update: already Escalated, Needs Review left alone</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{"Status": "Escalated", "Priority": "Medium", "Locked__c": false, "Needs_Review__c": false}</sobjectValue>
            </value>
        </parameters>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordUpdated</type>
            <value>
                <sobjectValue>{"Status": "Escalated", "Priority": "High", "Locked__c": false, "Needs_Review__c": false}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>$Record.Needs_Review__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <errorMessage>Needs Review should stay unticked when the status did not change</errorMessage>
        </assertions>
        <assertions>
            <conditions>
                <leftValueReference>Ask_For_Review</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <errorMessage>The "Ask for review" outcome should not be taken</errorMessage>
        </assertions>
        <assertions>
            <conditions>
                <leftValueReference>Not_Eligible</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <errorMessage>The "Not eligible" outcome should not be taken</errorMessage>
        </assertions>
        <elementApiName>Finish</elementApiName>
        <isUseMockOutput>false</isUseMockOutput>
    </testPoints>
    <testType>WithAssertion</testType>
</FlowTest>
